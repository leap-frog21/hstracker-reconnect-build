diff --git a/HSTracker/Logging/BattlegroundsReconnectPolicy.swift b/HSTracker/Logging/BattlegroundsReconnectPolicy.swift
new file mode 100644
index 0000000..4158121
--- /dev/null
+++ b/HSTracker/Logging/BattlegroundsReconnectPolicy.swift
@@ -0,0 +1,19 @@
+import Foundation
+
+/// Retain match-level caches only when a running Battlegrounds match is
+/// positively identified again. A reused entity/player ID is not a match ID.
+enum BattlegroundsReconnectPolicy {
+    static func shouldPreserveSession(
+        activeBattlegroundsMatch: Bool,
+        cachedGameHandle: String?,
+        observedGameHandle: String?
+    ) -> Bool {
+        guard activeBattlegroundsMatch,
+              let cachedGameHandle, let observedGameHandle,
+              let cached = UInt64(cachedGameHandle), cached > 0,
+              let observed = UInt64(observedGameHandle), observed > 0 else {
+            return false
+        }
+        return cached == observed
+    }
+}
